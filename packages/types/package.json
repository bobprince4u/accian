{
  "name": "@accian/types",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Shared API contract types for the ACCIAN product. Framework-agnostic: no database, HTTP, React or provider code.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node ./scripts/write-cjs-package-type.mjs",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
